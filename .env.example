# MedExplain AI - configuration
# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Free key: https://aistudio.google.com/app/apikey
# If unset, the system uses the grounded fallback generator, which still cites
# retrieved sources and still passes the safety gate.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Gemini 3.x uses a thinking level instead of temperature.
# MINIMAL | LOW | MEDIUM | HIGH. LOW keeps a live demo fast and costs less,
# because thinking tokens are billed as output tokens.
GEMINI_THINKING_LEVEL=LOW

# --- Information Retrieval -------------------------------------------------
# auto     : try ChromaDB, fall back to the built-in BM25 index
# chromadb : force ChromaDB (fails loudly if the embedding model cannot load)
# bm25     : force the dependency-free BM25 backend
VECTOR_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Below this similarity the retrieval agent reports no context and the
# explanation agent abstains instead of guessing.
RETRIEVAL_MIN_RELEVANCE=0.15

# --- Agent communication protocol ------------------------------------------
# stdio     : real MCP JSON-RPC to agents/retrieval/mcp_server.py (use for the demo)
# inprocess : same tool contract, called directly (faster, no subprocess)
# auto      : stdio when the MCP SDK is installed
MCP_TRANSPORT=auto
# Seconds to wait for the MCP server subprocess to start. The first start loads
# (and may download) the embedding model, which is slow; a short timeout shows
# up as "unhandled errors in a TaskGroup" and a fall back to in-process.
MCP_TIMEOUT_SECONDS=180

# --- Safety ----------------------------------------------------------------
# Fraction of sentences that must be supported by retrieved sources.
SAFETY_GROUNDEDNESS_THRESHOLD=0.5
# How many times a rejected draft is sent back to the explanation agent
# before the pipeline fails closed.
MAX_SAFETY_REVISIONS=2

# --- Web -------------------------------------------------------------------
# Comma-separated. Do not use "*" with credentials enabled.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
MEDEXPLAIN_LOG_DIR=logs

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medexplain_db
# Secret key for field-level AES-256 database encryption at rest.
# MUST be set in environment / .env. Do NOT commit real keys.
MEDEXPLAIN_DB_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
